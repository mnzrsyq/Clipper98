<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\clipper98.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <AssemblyName>Clipper98</AssemblyName>
    <RootNamespace>Clipper98</RootNamespace>
    <Version>1.1.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.78.0.4325" />
    <Resource Include="assets\clipper98.ico" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" ExcludeAssets="analyzers" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <Content Include="SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".gemini\skills\clipper\SKILL.md" Link=".gemini\skills\clipper\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include=".gemini\skills\clipper-ringkas\SKILL.md" Link=".gemini\skills\clipper-ringkas\SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="HOW-TO-USE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="tools\fonts\**\*" Link="tools\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\LICENSE-OpenCV.txt" Link="tools\models\LICENSE-OpenCV.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
