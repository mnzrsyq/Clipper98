<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
    <AssemblyName>Clipper98</AssemblyName>
    <RootNamespace>Clipper98</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" ExcludeAssets="analyzers" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <Content Include="clipper_runner.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="HOW-TO-USE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fonts\Montserrat[wght].ttf" Link="tools\fonts\Montserrat[wght].ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fonts\Poppins-ExtraBold.ttf" Link="tools\fonts\Poppins-ExtraBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fonts\Montserrat-OFL.txt" Link="tools\fonts\Montserrat-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fonts\Poppins-OFL.txt" Link="tools\fonts\Poppins-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\haarcascade_frontalface_default.xml" Link="tools\models\haarcascade_frontalface_default.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\LICENSE-OpenCV.txt" Link="tools\models\LICENSE-OpenCV.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="fonts\Montserrat[wght].ttf" />
    <Resource Include="fonts\Poppins-ExtraBold.ttf" />
  </ItemGroup>
</Project>
