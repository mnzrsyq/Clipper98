<Window x:Class="Clipper98.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clipper98"
        Title="Clipper 98" Height="980" Width="1480" MinHeight="820" MinWidth="1160"
        Background="{StaticResource FaceBrush}" FontFamily="Tahoma" FontSize="12">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="155" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource TitleBrush}" Padding="8,5" Margin="0,0,0,4">
      <Grid>
        <TextBlock Text="CLIPPER 98  |  LOCAL VIDEO CLIP MAKER" Foreground="White" FontWeight="Bold" />
        <Button x:Name="SetupButton" Content="SETUP" Width="78" Height="24" Padding="3,1" HorizontalAlignment="Right" Click="SetupButton_Click" />
      </Grid>
    </Border>

    <Border Grid.Row="1" BorderBrush="#808080" BorderThickness="1" Background="{StaticResource WindowBrush}" Padding="10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,10,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="SOURCE URL" FontWeight="Bold" Margin="0,0,0,3" />
            <TextBox x:Name="UrlBox" ToolTip="Tempel URL YouTube publik di sini" TextChanged="UrlBox_TextChanged" />
          </StackPanel>
          <DockPanel Grid.Row="1" Margin="0,6,0,0" LastChildFill="False">
            <TextBlock Text="GEMINI KEY" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0" />
            <PasswordBox x:Name="GeminiKeyBox" Width="255" ToolTip="Disimpan terenkripsi di akun Windows ini saat Analisis Gemini ditekan." />
            <TextBlock Text="MODEL" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox x:Name="GeminiModelBox" Width="170" SelectedIndex="0" ToolTip="Pilih model untuk analisis video">
              <ComboBoxItem Content="gemini-4-hydrogen" />
              <ComboBoxItem Content="gemini-4-argon" />
              <ComboBoxItem Content="gemini-3.8-flash" />
            </ComboBox>
          </DockPanel>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="GeminiAnalyzeButton" Content="ANALISIS GEMINI" Height="26" Margin="0,1" Padding="3,1" Click="GeminiAnalyzeButton_Click" />
          <Button x:Name="CopyPromptButton" Content="SALIN PROMPT" Height="26" Margin="0,1" Padding="3,1" Click="CopyPromptButton_Click" />
          <Button x:Name="ImportScriptButton" Content="IMPORT .PY" Height="26" Margin="0,1" Padding="3,1" Click="ImportScriptButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.82*" MinWidth="275" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.42*" MinWidth="360" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.05*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#808080" BorderThickness="1" Background="{StaticResource WindowBrush}" Padding="8" Margin="0,0,0,7">
          <StackPanel>
            <TextBlock Text="JUMLAH OTOMATIS" FontWeight="Bold" Margin="0,0,0,4" />
            <DockPanel LastChildFill="False">
              <TextBox x:Name="CandidateCountBox" Text="5" Width="48" VerticalContentAlignment="Center" />
              <Button Content="BUAT TIMESTAMP" Margin="8,0,0,0" Padding="6,2" Click="AddTimestampButton_Click" />
            </DockPanel>
          </StackPanel>
        </Border>
        <GroupBox Grid.Row="1" Header="KANDIDAT KLIP" Background="{StaticResource WindowBrush}">
          <ListBox x:Name="ClipList" SelectionChanged="ClipList_SelectionChanged" BorderBrush="#707070" BorderThickness="1">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2">
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="ClipSelection_Click" VerticalAlignment="Top" Margin="2,3,7,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Hook}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TimeRange}" Foreground="#505050" FontSize="10" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>
        <StackPanel Grid.Row="2" Margin="0,7,0,0">
          <TextBlock x:Name="ClipDetail" Text="Impor manifest Gemini atau analisis URL untuk menampilkan kandidat." TextWrapping="Wrap" Foreground="#303030" />
          <DockPanel Margin="0,6,0,0">
            <TextBlock Text="MULAI" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="StartTimeBox" Width="70" ToolTip="HH:MM:SS" Text="00:00:00" />
            <TextBlock Text="SELESAI" VerticalAlignment="Center" Margin="7,0,4,0" />
            <TextBox x:Name="EndTimeBox" Width="70" ToolTip="HH:MM:SS" Text="00:00:30" />
            <Button Content="UPDATE" Margin="6,0,0,0" Padding="6,2" Click="UpdateTimestampButton_Click" />
          </DockPanel>
        </StackPanel>
      </Grid>

      <GroupBox Grid.Column="2" Header="PREVIEW  |  9:16" Background="#202124" Foreground="#E8EAED">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
            <Border BorderBrush="#53565A" BorderThickness="1" Background="#15171A">
              <Canvas x:Name="PreviewCanvas" Width="270" Height="480" ClipToBounds="True">
                <Image x:Name="PreviewBackdrop" Width="270" Height="480" Stretch="UniformToFill" />
                <Border x:Name="PreviewPlaceholder" Width="270" Height="480" Background="#15171A">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25">
                    <TextBlock Text="PREVIEW 9:16" Foreground="#AEB4BC" FontFamily="Consolas" FontSize="17" FontWeight="Bold" TextAlignment="Center" />
                    <TextBlock Text="Masukkan URL atau impor manifest\nuntuk melihat thumbnail dan subtitle." Foreground="#7F8790" FontFamily="Consolas" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
                <Image x:Name="PreviewFullFrame" Width="270" Height="480" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                <Image x:Name="PreviewFrame" Width="270" Height="480" Stretch="Fill" IsHitTestVisible="False" />
                <local:CaptionPreviewElement x:Name="PreviewCaption" Canvas.Left="20" Width="230" Height="480" IsHitTestVisible="False" />
              </Canvas>
            </Border>
          </Viewbox>
          <TextBlock Grid.Row="1" Text="Thumbnail statis untuk komposisi; hasil render tetap memakai video klip." Foreground="#AEB4BC" FontSize="10" TextWrapping="Wrap" Margin="2,5,2,0" />
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="4" Header="SUBTITLE &amp; FRAME" Background="{StaticResource WindowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="SUMBER TRANSKRIP" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox x:Name="SubtitleSourceBox" SelectionChanged="SubtitleSourceBox_SelectionChanged" SelectedIndex="0" ToolTip="Pilih sumber subtitle atau paksa transkrip ulang dengan Whisper">
              <ComboBoxItem Content="Otomatis — subtitle YouTube" Tag="auto" />
              <ComboBoxItem Content="Whisper — transkrip ulang" Tag="whisper" />
            </ComboBox>
            <TextBlock Text="BAHASA" FontWeight="Bold" Margin="0,10,0,3" />
            <ComboBox x:Name="LanguageBox" SelectedIndex="1" ToolTip="Bahasa untuk subtitle YouTube dan transkrip Whisper">
              <ComboBoxItem Content="Otomatis" Tag="auto" />
              <ComboBoxItem Content="Indonesia" Tag="id" />
              <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <TextBlock Text="MODEL WHISPER" FontWeight="Bold" Margin="0,9,0,3" />
            <ComboBox x:Name="WhisperModelBox" SelectionChanged="WhisperModelBox_SelectionChanged" SelectedIndex="0" ToolTip="Large-v3-Turbo reguler sekitar 1,5 GiB; Q8_0 lebih kecil sekitar 834 MiB.">
              <ComboBoxItem Content="Large-v3-Turbo — reguler, 1,5 GiB" Tag="large-v3-turbo" />
              <ComboBoxItem Content="Large-v3-Turbo Q8_0 — 834 MiB" Tag="large-v3-turbo-q8_0" />
            </ComboBox>

            <Separator Margin="0,12,0,8" />
            <TextBlock Text="PRESET" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="Bold Pop - balanced" />
              <ComboBoxItem Content="Clean White" />
              <ComboBoxItem Content="Yellow Focus" />
            </ComboBox>
            <TextBlock Text="SIMPAN PRESET SAAT INI" FontWeight="Bold" Margin="0,7,0,3" />
            <DockPanel LastChildFill="True">
              <Button x:Name="DeletePresetButton" DockPanel.Dock="Right" Content="HAPUS" Padding="5,2" Margin="5,0,0,0" IsEnabled="False" Click="DeletePresetButton_Click" />
              <Button x:Name="SavePresetButton" DockPanel.Dock="Right" Content="SIMPAN" Padding="5,2" Margin="5,0,0,0" Click="SavePresetButton_Click" />
              <TextBox x:Name="PresetNameBox" ToolTip="Nama preset subtitle" />
            </DockPanel>
            <TextBlock Text="FONT" FontWeight="Bold" Margin="0,9,0,3" />
            <DockPanel LastChildFill="True">
              <Button x:Name="ImportFontButton" DockPanel.Dock="Right" Content="IMPORT FONT" Margin="6,0,0,0" Padding="6,2" Click="ImportFontButton_Click" ToolTip="Salin file .ttf/.otf ke font Clipper 98 milik akun Windows ini." />
              <ComboBox x:Name="FontBox" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" SelectionChanged="FontBox_SelectionChanged" />
            </DockPanel>
            <TextBlock Text="GAYA FONT" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="FontStyleBox" SelectionChanged="StyleControl_Changed" SelectedIndex="1">
              <ComboBoxItem Content="Regular" Tag="regular" />
              <ComboBoxItem Content="Bold" Tag="bold" />
              <ComboBoxItem Content="Italic" Tag="italic" />
              <ComboBoxItem Content="Bold Italic" Tag="bold-italic" />
            </ComboBox>
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="UKURAN" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="FontSizeLabel" Text="100 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="FontSizeSlider" Minimum="80" Maximum="120" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />
            <TextBlock Text="WARNA TEKS" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="TextColorBox" SelectionChanged="StyleControl_Changed" SelectedIndex="0">
              <ComboBoxItem Content="White" /><ComboBoxItem Content="Yellow" /><ComboBoxItem Content="Cyan" /><ComboBoxItem Content="Pink" />
            </ComboBox>
            <TextBlock Text="WARNA KATA AKTIF" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="HighlightColorBox" SelectionChanged="StyleControl_Changed" SelectedIndex="0">
              <ComboBoxItem Content="Yellow" /><ComboBoxItem Content="Cyan" /><ComboBoxItem Content="Pink" />
            </ComboBox>
            <TextBlock Text="OUTLINE" FontWeight="Bold" Margin="0,7,0,3" />
            <Slider x:Name="OutlineSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />
            <DockPanel Margin="0,7,0,0">
              <TextBlock Text="JARAK HURUF" FontWeight="Bold" VerticalAlignment="Center" ToolTip="Letter spacing (ASS), bukan kerning pasangan karakter otomatis." />
              <TextBlock x:Name="LetterSpacingLabel" Text="0 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="LetterSpacingSlider" Minimum="-5" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" ToolTip="Jarak antarhuruf dalam piksel output." />
            <CheckBox x:Name="HighlightBox" Content="Highlight kata yang diucap" IsChecked="True" Margin="0,5,0,0" Checked="StyleControl_Changed" Unchecked="StyleControl_Changed" />

            <TextBlock Text="JUMLAH BARIS" FontWeight="Bold" Margin="0,10,0,3" />
            <ComboBox x:Name="MaxLinesBox" SelectionChanged="StyleControl_Changed" SelectedIndex="1">
              <ComboBoxItem Content="1 baris" Tag="1" /><ComboBoxItem Content="2 baris" Tag="2" />
              <ComboBoxItem Content="3 baris" Tag="3" /><ComboBoxItem Content="4 baris" Tag="4" />
            </ComboBox>
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="JARAK BARIS" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="LineSpacingLabel" Text="10 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="LineSpacingSlider" Minimum="0" Maximum="60" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" ToolTip="Jarak tambahan antarbaris dalam piksel output." />
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="POSISI Y" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="PositionYLabel" Text="1420 / 1920 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="PositionYSlider" Minimum="300" Maximum="1780" Value="1420" TickFrequency="40" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />

            <Separator Margin="0,11,0,8" />
            <TextBlock Text="FRAMING KLIP TERPILIH" FontWeight="Bold" Margin="0,0,0,4" />
            <CheckBox x:Name="PreserveFullFrameBox" Content="Ada objek/slide penting — jaga seluruh frame" Checked="PreserveFullFrame_Changed" Unchecked="PreserveFullFrame_Changed" ToolTip="Kalau dicentang, seluruh video asli terlihat di kanvas 9:16 dengan latar blur. Kalau tidak, wajah utama diikuti smart crop." />
            <TextBlock Text="Smart crop mengikuti wajah. Jika wajah tak terdeteksi selama 2 detik atau lebih, tampilan sementara beralih ke video utuh dengan latar blur. Centang opsi di atas untuk memakai mode ini sepanjang klip." Foreground="#404040" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="FRAME PNG" FontWeight="Bold" VerticalAlignment="Center" />
              <Button x:Name="FrameUploadButton" Content="PILIH" Padding="7,2" Click="FrameUploadButton_Click" />
              <Button x:Name="FrameRemoveButton" Content="HAPUS" Padding="7,2" Margin="5,0,0,0" Click="FrameRemoveButton_Click" />
            </DockPanel>
            <TextBlock x:Name="FramePathText" Text="Belum ada frame" Foreground="#404040" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
          </StackPanel>
        </ScrollViewer>
      </GroupBox>
    </Grid>

    <GroupBox Grid.Row="3" Header="LOG PROSES" Background="#101319" Foreground="#D7E2F0" Margin="0,8,0,0">
      <RichTextBox x:Name="LogBox" Background="#101319" Foreground="#D7E2F0" BorderThickness="0" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextOptions.TextFormattingMode="Display">
        <FlowDocument PagePadding="3" Background="#101319" TextAlignment="Left" />
      </RichTextBox>
    </GroupBox>

    <Border Grid.Row="4" Background="{StaticResource WindowBrush}" BorderBrush="#808080" BorderThickness="1" Padding="9" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="145" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="OUTPUT FOLDER" FontWeight="Bold" />
          <DockPanel Margin="0,3,8,0">
            <Button DockPanel.Dock="Right" Content="BROWSE" Width="75" Margin="6,0,0,0" Click="BrowseButton_Click" />
            <TextBox x:Name="OutputBox" IsReadOnly="True" />
          </DockPanel>
        </StackPanel>
        <Button x:Name="OpenFolderButton" Grid.Column="1" Content="OPEN FOLDER" Margin="8,17,0,0" Height="32" Click="OpenFolderButton_Click" />
        <Button x:Name="RenderButton" Grid.Column="2" Content="CREATE CLIP" Background="#D6AF28" Margin="8,17,0,0" Height="32" Click="RenderButton_Click" IsEnabled="False" />
        <Button x:Name="CancelButton" Grid.Column="3" Content="BATAL" Margin="8,17,0,0" Height="32" Click="CancelButton_Click" IsEnabled="False" />
      </Grid>
    </Border>

    <Border Grid.Row="5" Background="#202020" Padding="6,4" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock x:Name="StatusText" Foreground="#FFFFFF" Text="STATUS: isi URL dan Gemini key, lalu pilih Analisis Gemini atau pakai prompt/manifest CLI." />
        <ProgressBar x:Name="WorkProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
