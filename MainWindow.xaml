<Window x:Class="Clipper98.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Clipper98"
        Title="Clipper 98" Icon="pack://application:,,,/assets/clipper98.ico" Height="980" Width="1480" MinHeight="820" MinWidth="1160"
        Background="{DynamicResource FaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Tahoma" FontSize="12" Language="en-US">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="155" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource TitleBrush}" Padding="5,3" Margin="0,0,0,4">
      <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <ToggleButton x:Name="EditorModeButton" Style="{StaticResource ModeIconButtonStyle}" IsChecked="True" Click="WorkspaceMode_Click"
                        ToolTip="Editor" AutomationProperties.Name="Editor">
            <Image Source="{StaticResource ClapperboardIcon}" Width="28" Height="28" SnapsToDevicePixels="True" />
          </ToggleButton>
          <ToggleButton x:Name="YouTubeModeButton" Style="{StaticResource ModeIconButtonStyle}" Click="WorkspaceMode_Click"
                        ToolTip="YouTube" AutomationProperties.Name="YouTube">
            <Image Source="{StaticResource YouTubeIcon}" Width="28" Height="28" SnapsToDevicePixels="True" />
          </ToggleButton>
        </StackPanel>
        <Button x:Name="SetupButton" Content="SETUP" Width="78" Height="24" Padding="3,1" HorizontalAlignment="Right" Click="SetupButton_Click" />
      </Grid>
    </Border>

    <Border x:Name="EditorSourcePanel" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}" Padding="10" Margin="0,0,0,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,10,0">
          <StackPanel>
            <TextBlock Text="SOURCE URL" FontWeight="Bold" Margin="0,0,0,3" />
            <TextBox x:Name="UrlBox" ToolTip="Paste a public YouTube URL here." TextChanged="UrlBox_TextChanged" />
          </StackPanel>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <Button x:Name="CopyPromptButton" Content="COPY GEMINI PROMPT" Height="26" Margin="0,1" Padding="3,1" Click="CopyPromptButton_Click" />
          <Button x:Name="ImportScriptButton" Content="IMPORT .PY" Height="26" Margin="0,1" Padding="3,1" Click="ImportScriptButton_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.82*" MinWidth="275" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.42*" MinWidth="360" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="1.05*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="EditorOptionsPanel" Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource WindowBrush}" Padding="8" Margin="0,0,0,7">
          <StackPanel>
            <TextBlock Text="MODE" FontWeight="Bold" Margin="0,0,0,4" />
            <ComboBox x:Name="ProcessingModeBox" SelectionChanged="ProcessingModeBox_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="Short Clips" Tag="short_clips" />
              <ComboBoxItem Content="Condense Video" Tag="condense" />
            </ComboBox>
            <StackPanel x:Name="ShortClipOptionsPanel" Margin="0,8,0,0">
              <TextBlock Text="CLIP COUNT" FontWeight="Bold" Margin="0,0,0,4" />
              <DockPanel LastChildFill="False">
                <TextBox x:Name="CandidateCountBox" Text="5" Width="48" VerticalContentAlignment="Center" />
                <Button Content="ADD TIMESTAMP" Margin="8,0,0,0" Padding="6,2" Click="AddTimestampButton_Click" />
              </DockPanel>
            </StackPanel>
            <StackPanel x:Name="CondensedOptionsPanel" Margin="0,8,0,0" Visibility="Collapsed">
              <TextBlock Text="OUTPUT DURATION" FontWeight="Bold" Margin="0,0,0,4" />
              <ComboBox x:Name="TargetDurationBox" SelectedIndex="0">
                <ComboBoxItem Content="Automatic" Tag="0" />
                <ComboBoxItem Content="About 3 minutes" Tag="180" />
                <ComboBoxItem Content="About 5 minutes" Tag="300" />
                <ComboBoxItem Content="About 10 minutes" Tag="600" />
              </ComboBox>
              <TextBlock Text="VIDEO ASPECT RATIO" FontWeight="Bold" Margin="0,8,0,4" />
              <ComboBox x:Name="CondensedAspectBox" SelectedIndex="0" SelectionChanged="CondensedAspect_Changed">
                <ComboBoxItem Content="Match source" Tag="source" />
                <ComboBoxItem Content="Vertical 9:16 · 4:5 content" Tag="portrait" />
              </ComboBox>
              <CheckBox x:Name="CondensedNarrationCheckBox" Content="Add voice-over narration" IsChecked="False" Margin="0,5,0,0" Checked="NarrationEnabled_Changed" Unchecked="NarrationEnabled_Changed" />
              <Expander x:Name="NarrationSettingsExpander" Header="VOICE SETTINGS" IsExpanded="False" Margin="0,4,0,0">
                <StackPanel x:Name="NarrationSettingsPanel" Margin="4,4,0,0" IsEnabled="False">
                  <TextBlock Text="TEXT-TO-SPEECH ENGINE" FontWeight="Bold" Margin="0,0,0,3" />
                  <ComboBox x:Name="TtsProviderBox" SelectionChanged="TtsProvider_Changed" SelectedIndex="0">
                    <ComboBoxItem Content="Online · Edge TTS" Tag="edge" />
                    <ComboBoxItem Content="Online · Fish Audio S2.1 Pro Free" Tag="fish" />
                  </ComboBox>
                  <TextBlock x:Name="FishApiKeyLabel" Text="FISH AUDIO API KEY" FontWeight="Bold" Margin="0,7,0,3" />
                  <PasswordBox x:Name="FishApiKeyBox" PasswordChanged="FishApiKey_Changed" ToolTip="API key disimpan terenkripsi di PC ini." />
                  <TextBlock Text="The key is encrypted on this PC. Manage it from your Fish Audio account." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                  <TextBlock Text="VOICE" FontWeight="Bold" Margin="0,7,0,3" />
                  <ComboBox x:Name="TtsVoiceBox" SelectionChanged="TtsControl_Changed" />
                  <DockPanel Margin="0,7,0,0">
                    <TextBlock Text="SPEECH RATE" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TtsRateLabel" Text="Normal" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider x:Name="TtsRateSlider" Minimum="-30" Maximum="30" Value="0" TickFrequency="5" ValueChanged="TtsControl_Changed" ToolTip="Adjust narration speed without changing video playback." />
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="NARRATION VOLUME" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TtsVolumeLabel" Text="100%" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="150" Value="100" TickFrequency="10" ValueChanged="TtsControl_Changed" />
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="SOURCE AUDIO" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="OriginalVolumeLabel" Text="55%" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider x:Name="OriginalVolumeSlider" Minimum="0" Maximum="150" Value="55" TickFrequency="10" ValueChanged="TtsControl_Changed" ToolTip="Adjust the source audio level under the narration." />
                  <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="PITCH" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TtsPitchLabel" Text="0" HorizontalAlignment="Right" />
                  </DockPanel>
                  <Slider x:Name="TtsPitchSlider" Minimum="-300" Maximum="300" Value="0" TickFrequency="50" ValueChanged="TtsControl_Changed" ToolTip="Adjust voice pitch. Zero keeps the original pitch." />
                  <TextBlock Text="Fish Audio and Edge TTS require an internet connection." FontSize="10" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </Border>
        <GroupBox x:Name="ClipListGroupBox" Grid.Row="1" Header="CLIP CANDIDATES" Background="{DynamicResource WindowBrush}">
          <ListBox x:Name="ClipList" SelectionChanged="ClipList_SelectionChanged" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InputTextBrush}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2">
                  <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Click="ClipSelection_Click" VerticalAlignment="Top" Margin="2,3,7,0" />
                  <StackPanel>
                    <TextBlock Text="{Binding Hook}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding TimeRange}" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </GroupBox>
        <StackPanel x:Name="EditorClipDetailsPanel" Grid.Row="2" Margin="0,7,0,0">
          <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ClipDetail" Text="Import a manifest created by @clipper to view its candidates." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
          </ScrollViewer>
          <DockPanel x:Name="TimestampEditPanel" Margin="0,6,0,0">
            <TextBlock Text="START" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="StartTimeBox" Width="70" ToolTip="HH:MM:SS" Text="00:00:00" />
            <TextBlock Text="END" VerticalAlignment="Center" Margin="7,0,4,0" />
            <TextBox x:Name="EndTimeBox" Width="70" ToolTip="HH:MM:SS" Text="00:00:30" />
            <Button Content="UPDATE TIMESTAMP" Margin="6,0,0,0" Padding="6,2" Click="UpdateTimestampButton_Click" />
          </DockPanel>
        </StackPanel>
      </Grid>

      <GroupBox x:Name="EditorPreviewGroup" Grid.Column="2" Header="PREVIEW  |  9:16" Background="#202124" Foreground="#E8EAED">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="DownOnly" Margin="2">
            <Border BorderBrush="#53565A" BorderThickness="1" Background="#15171A">
              <Canvas x:Name="PreviewCanvas" Width="270" Height="480" ClipToBounds="True">
                <Image x:Name="PreviewBackdrop" Width="270" Height="480" Stretch="UniformToFill" />
                <Border x:Name="PreviewPlaceholder" Width="270" Height="480" Background="#15171A">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="25">
                    <TextBlock Text="PREVIEW 9:16" Foreground="#AEB4BC" FontFamily="Consolas" FontSize="17" FontWeight="Bold" TextAlignment="Center" />
            <TextBlock Text="Enter a URL or import a manifest\nto preview the thumbnail and subtitles." Foreground="#C1C7CE" FontFamily="Consolas" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                  </StackPanel>
                </Border>
                <Image x:Name="PreviewFullFrame" Width="270" Height="480" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                <Image x:Name="PreviewFrame" Width="270" Height="480" Stretch="Fill" IsHitTestVisible="False" />
                <local:CaptionPreviewElement x:Name="PreviewCaption" Canvas.Left="20" Width="230" Height="480" IsHitTestVisible="False" />
              </Canvas>
            </Border>
          </Viewbox>
          <TextBlock Grid.Row="1" Text="The static thumbnail shows framing only. The rendered clip uses the source video." Foreground="#AEB4BC" FontSize="10" TextWrapping="Wrap" Margin="2,5,2,0" />
        </Grid>
      </GroupBox>

      <GroupBox x:Name="EditorStyleGroup" Grid.Column="4" Header="SUBTITLES &amp; FRAME" Background="{DynamicResource WindowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <CheckBox x:Name="ShortClipSubtitleCheckBox" Content="Show subtitles on short clips" IsChecked="True" Margin="0,0,0,8" Visibility="Collapsed" Checked="ShortClipSubtitle_Changed" Unchecked="ShortClipSubtitle_Changed" />
            <CheckBox x:Name="CondensedSubtitleCheckBox" Content="Show subtitles on condensed videos" IsChecked="False" Margin="0,0,0,8" Visibility="Collapsed" Checked="CondensedSubtitle_Changed" Unchecked="CondensedSubtitle_Changed" />
            <StackPanel x:Name="SubtitleSettingsPanel">
            <TextBlock Text="TRANSCRIPT SOURCE" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox x:Name="SubtitleSourceBox" SelectionChanged="SubtitleSourceBox_SelectionChanged" SelectedIndex="0" ToolTip="Choose YouTube subtitles or transcribe again with Whisper.">
              <ComboBoxItem Content="Automatic · YouTube subtitles" Tag="auto" />
              <ComboBoxItem Content="Whisper · transcribe again" Tag="whisper" />
            </ComboBox>
            <TextBlock Text="LANGUAGE" FontWeight="Bold" Margin="0,10,0,3" />
            <ComboBox x:Name="LanguageBox" SelectedIndex="1" ToolTip="Language for YouTube subtitles and Whisper transcription.">
              <ComboBoxItem Content="Automatic" Tag="auto" />
              <ComboBoxItem Content="Indonesian" Tag="id" />
              <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <Separator Margin="0,12,0,8" />
            <TextBlock Text="PRESET" FontWeight="Bold" Margin="0,0,0,3" />
            <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged" SelectedIndex="0">
              <ComboBoxItem Content="Bold Pop - balanced" />
              <ComboBoxItem Content="Clean White" />
              <ComboBoxItem Content="Yellow Focus" />
            </ComboBox>
            <TextBlock Text="SAVE CURRENT PRESET" FontWeight="Bold" Margin="0,7,0,3" />
            <DockPanel LastChildFill="True">
              <Button x:Name="DeletePresetButton" DockPanel.Dock="Right" Content="DELETE" Padding="5,2" Margin="5,0,0,0" IsEnabled="False" Click="DeletePresetButton_Click" />
              <Button x:Name="SavePresetButton" DockPanel.Dock="Right" Content="SAVE" Padding="5,2" Margin="5,0,0,0" Click="SavePresetButton_Click" />
              <TextBox x:Name="PresetNameBox" ToolTip="Subtitle preset name." />
            </DockPanel>
            <TextBlock Text="FONT" FontWeight="Bold" Margin="0,9,0,3" />
            <DockPanel LastChildFill="True">
              <Button x:Name="ImportFontButton" DockPanel.Dock="Right" Content="IMPORT FONT" Margin="6,0,0,0" Padding="6,2" Click="ImportFontButton_Click" ToolTip="Copy a .ttf or .otf file to this Windows account's Clipper 98 fonts folder." />
              <ComboBox x:Name="FontBox" DisplayMemberPath="DisplayName" IsTextSearchEnabled="True" SelectionChanged="FontBox_SelectionChanged" />
            </DockPanel>
            <TextBlock Text="FONT STYLE" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="FontStyleBox" SelectionChanged="StyleControl_Changed" SelectedIndex="1">
              <ComboBoxItem Content="Regular" Tag="regular" />
              <ComboBoxItem Content="Bold" Tag="bold" />
              <ComboBoxItem Content="Italic" Tag="italic" />
              <ComboBoxItem Content="Bold Italic" Tag="bold-italic" />
            </ComboBox>
            <TextBlock Text="LETTER CASE" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="TextCaseBox" SelectionChanged="StyleControl_Changed" SelectedIndex="0">
              <ComboBoxItem Content="Sentence case" Tag="sentence" />
              <ComboBoxItem Content="lowercase" Tag="lowercase" />
              <ComboBoxItem Content="UPPERCASE" Tag="uppercase" />
              <ComboBoxItem Content="Title Case" Tag="title" />
              <ComboBoxItem Content="tOGGLE cASE" Tag="toggle" />
            </ComboBox>
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="SIZE" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="FontSizeLabel" Text="100 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="FontSizeSlider" Minimum="80" Maximum="120" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />
            <TextBlock Text="TEXT COLOR" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="TextColorBox" SelectionChanged="ColorChoice_Changed" SelectedIndex="0">
              <ComboBoxItem Content="White" Tag="White" /><ComboBoxItem Content="Yellow" Tag="Yellow" /><ComboBoxItem Content="Pink" Tag="Pink" /><ComboBoxItem Content="Red" Tag="Red" /><ComboBoxItem Content="Custom HEX" Tag="custom" />
            </ComboBox>
            <TextBox x:Name="TextColorHexBox" Text="#FFFFFF" Margin="0,3,0,0" ToolTip="Enter a color in #RRGGBB format." TextChanged="ColorHex_TextChanged" />
            <TextBlock Text="HIGHLIGHTED WORD COLOR" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="HighlightColorBox" SelectionChanged="ColorChoice_Changed" SelectedIndex="1">
              <ComboBoxItem Content="White" Tag="White" /><ComboBoxItem Content="Yellow" Tag="Yellow" /><ComboBoxItem Content="Pink" Tag="Pink" /><ComboBoxItem Content="Red" Tag="Red" /><ComboBoxItem Content="Custom HEX" Tag="custom" />
            </ComboBox>
            <TextBox x:Name="HighlightColorHexBox" Text="#FFD329" Margin="0,3,0,0" ToolTip="Enter a highlight color in #RRGGBB format." TextChanged="ColorHex_TextChanged" />
            <TextBlock Text="HIGHLIGHT STYLE" FontWeight="Bold" Margin="0,7,0,3" />
            <ComboBox x:Name="HighlightModeBox" SelectionChanged="StyleControl_Changed" SelectedIndex="0">
              <ComboBoxItem Content="Change text color" Tag="color" /><ComboBoxItem Content="Box behind the word" Tag="box" />
            </ComboBox>
            <TextBlock Text="OUTLINE" FontWeight="Bold" Margin="0,7,0,3" />
            <Slider x:Name="OutlineSlider" Minimum="1" Maximum="10" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />
            <DockPanel Margin="0,7,0,0">
              <TextBlock Text="LETTER SPACING" FontWeight="Bold" VerticalAlignment="Center" ToolTip="ASS letter spacing in output pixels." />
              <TextBlock x:Name="LetterSpacingLabel" Text="0 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="LetterSpacingSlider" Minimum="-5" Maximum="12" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" ToolTip="Space between characters in the rendered video." />
            <CheckBox x:Name="HighlightBox" Content="Highlight the spoken word" IsChecked="True" Margin="0,5,0,0" Checked="StyleControl_Changed" Unchecked="StyleControl_Changed" />

            <TextBlock Text="LINE COUNT" FontWeight="Bold" Margin="0,10,0,3" />
            <ComboBox x:Name="MaxLinesBox" SelectionChanged="StyleControl_Changed" SelectedIndex="1">
              <ComboBoxItem Content="One word" Tag="word" /><ComboBoxItem Content="1 line" Tag="1" /><ComboBoxItem Content="2 lines" Tag="2" />
            </ComboBox>
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="LINE SPACING" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="LineSpacingLabel" Text="10 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="LineSpacingSlider" Minimum="0" Maximum="60" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" ToolTip="Additional space between subtitle lines in output pixels." />
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="VERTICAL POSITION" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="PositionYLabel" Text="1420 / 1920 px" HorizontalAlignment="Right" />
            </DockPanel>
            <Slider x:Name="PositionYSlider" Minimum="300" Maximum="1780" Value="1420" TickFrequency="40" IsSnapToTickEnabled="True" ValueChanged="StyleControl_Changed" />
            </StackPanel>

            <Separator Margin="0,11,0,8" />
            <TextBlock x:Name="FramingHeaderText" Text="SELECTED CLIP FRAMING" FontWeight="Bold" Margin="0,0,0,4" />
            <CheckBox x:Name="SmartCropBox" Content="Smart Crop" Checked="SmartCrop_Changed" Unchecked="SmartCrop_Changed" ToolTip="On: crop follows the main face. Off: show the full frame over a blurred background." />
            <TextBlock x:Name="SmartCropHelpText" Text="If Smart Crop cannot detect a face for at least two seconds, the preview temporarily shows the full video over a blurred background." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
            <DockPanel Margin="0,9,0,0">
              <TextBlock Text="PNG FRAME" FontWeight="Bold" VerticalAlignment="Center" />
              <Button x:Name="FrameUploadButton" Content="BROWSE" Padding="7,2" Click="FrameUploadButton_Click" />
              <Button x:Name="FrameRemoveButton" Content="DELETE" Padding="7,2" Margin="5,0,0,0" Click="FrameRemoveButton_Click" />
            </DockPanel>
            <TextBlock x:Name="FramePathText" Text="No frame selected" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />

            <Separator Margin="0,12,0,8" />
            <Expander x:Name="YouTubeMetadataExpander" Header="YOUTUBE METADATA" IsExpanded="True">
              <StackPanel Margin="2,6,2,2">
                <TextBlock Text="Gemini metadata is prefilled for each clip. Edit it here before adding the rendered video to the publication queue." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5" />
                <TextBlock Text="TITLE" FontWeight="Bold" />
                <DockPanel Margin="0,3,0,2">
                  <TextBlock x:Name="YouTubeTitleCountText" DockPanel.Dock="Right" Text="0 / 100" VerticalAlignment="Center" Margin="6,0,0,0" />
                  <TextBox x:Name="YouTubeTitleBox" TextChanged="UploadMetadata_TextChanged" LostFocus="UploadMetadata_LostFocus" />
                </DockPanel>
                <Button x:Name="CopyYouTubeTitleButton" Content="COPY TITLE" HorizontalAlignment="Right" Padding="8,3" Click="CopyYouTubeTitleButton_Click" />

                <TextBlock Text="DESCRIPTION + HASHTAGS" FontWeight="Bold" Margin="0,9,0,0" />
                <TextBlock Text="Hashtags on the final line are included in the copied description." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,3" />
                <TextBox x:Name="YouTubeDescriptionBox" MinHeight="120" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="UploadMetadata_TextChanged" LostFocus="UploadMetadata_LostFocus" />
                <DockPanel Margin="0,3,0,0">
                  <Button x:Name="CopyYouTubeDescriptionButton" DockPanel.Dock="Right" Content="COPY DESCRIPTION" Padding="8,3" Click="CopyYouTubeDescriptionButton_Click" />
                  <TextBlock x:Name="YouTubeDescriptionCountText" Text="0 / 5000" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </GroupBox>

      <GroupBox x:Name="YouTubeWorkspacePanel" Grid.Column="0" Grid.ColumnSpan="5" Header="YOUTUBE PUBLISHING" Background="{DynamicResource WindowBrush}" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource FaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="WIB publishing slots" FontWeight="Bold" />
                <TextBlock Text="Weekdays  6:30 AM · 9:30 AM · 11:45 AM · 1:30 PM · 4:00 PM · 6:00 PM · 7:30 PM · 9:15 PM" TextWrapping="Wrap" Margin="0,3,0,0" />
                <TextBlock Text="Weekends  8:00 AM · 10:00 AM · 12:00 PM · 2:00 PM · 4:00 PM · 6:15 PM · 8:00 PM · 10:00 PM" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="Auto-Schedule fills the next available slot. Clipper uploads each video as Private and sends its publish time to YouTube." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0" />
                <TextBlock x:Name="YouTubeConnectionStatusText" Text="Not connected. Connect a YouTube channel to upload scheduled videos." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0" />
              </StackPanel>
              <Button x:Name="YouTubeConnectionButton" Grid.Column="1" Content="CONNECT YOUTUBE" MinWidth="150" Height="32" VerticalAlignment="Center" Click="YouTubeConnection_Click" />
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,5">
              <TextBlock Text="PUBLICATION QUEUE" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
              <CheckBox x:Name="SelectAllUploadCheckBox" Content="Select all" IsThreeState="True" VerticalAlignment="Center" Click="SelectAllUpload_Click" Margin="0,0,10,0" />
              <Button x:Name="AddQueueVideosButton" Content="ADD VIDEOS" Padding="7,3" Margin="0,0,5,0" Click="AddVideosToUploadQueue_Click" />
              <Button x:Name="ImportQueueMetadataButton" Content="IMPORT METADATA (.PY)" Padding="7,3" Margin="0,0,12,0" Click="ImportUploadMetadata_Click" />
              <Button x:Name="MoveQueueUpButton" Content="MOVE UP" Padding="7,3" Margin="0,0,5,0" ToolTip="Move selected rows up in the queue." Click="MoveQueueUp_Click" />
              <Button x:Name="MoveQueueDownButton" Content="MOVE DOWN" Padding="7,3" Margin="0,0,5,0" ToolTip="Move selected rows down in the queue." Click="MoveQueueDown_Click" />
              <Button x:Name="RemoveUploadQueueItemButton" Content="REMOVE SELECTED ROWS" Padding="7,3" ToolTip="Use Ctrl or Shift to select multiple rows." Click="RemoveUploadQueueItem_Click" />
            </DockPanel>
            <DataGrid x:Name="UploadScheduleGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="UploadScheduleGrid_SelectionChanged" HeadersVisibility="Column" BorderBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InputTextBrush}" RowHeaderWidth="0" MinHeight="180">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="UPLOAD" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="68" />
                <DataGridTextColumn Header="NO." Binding="{Binding QueueNumber}" Width="48" />
                <DataGridTextColumn Header="VIDEO" Binding="{Binding FileName}" Width="1.2*" IsReadOnly="True" />
                <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="1.5*" IsReadOnly="True" />
                <DataGridTextColumn Header="PUBLISH TIME (WIB)" Binding="{Binding PublishAtDisplay}" Width="1.2*" IsReadOnly="True" />
                <DataGridTextColumn Header="LOCAL FILE" Binding="{Binding FileState}" Width="0.9*" IsReadOnly="True" />
                <DataGridTextColumn Header="YOUTUBE STATUS" Binding="{Binding UploadStatus}" Width="1.1*" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="UploadEmptyStateText" Grid.Row="1" Text="No videos in the queue. Finished renders appear here automatically, or add existing MP4 files." TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" TextAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
            <TextBlock Grid.Row="2" Text="Local file status only indicates whether the video exists on this PC. YouTube status indicates upload progress." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0" />
            <Grid Grid.Row="3" Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="VIDEO TITLE" FontWeight="Bold" />
                <TextBox x:Name="QueueTitleBox" MaxLength="100" Margin="0,4,0,0" TextChanged="QueueMetadata_Changed" LostFocus="QueueMetadata_LostFocus" />
                <TextBlock Text="DESCRIPTION" FontWeight="Bold" Margin="0,7,0,0" />
                <TextBox x:Name="QueueDescriptionBox" MinHeight="55" MaxHeight="75" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="QueueMetadata_Changed" LostFocus="QueueMetadata_LostFocus" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="MANUAL PUBLISH TIME · WIB" FontWeight="Bold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <DatePicker x:Name="PublishDatePicker" Language="en-US" />
                <TextBox x:Name="PublishTimeBox" Text="19:30" Width="72" Margin="6,0,0,0" ToolTip="Enter a 24-hour time, for example 19:30." />
                </StackPanel>
                <Button x:Name="SetPublishTimeButton" Content="SET PUBLISH TIME" Margin="0,7,0,0" Padding="5,2" Click="SetPublishTime_Click" />
                <Button x:Name="ClearPublishTimeButton" Content="CLEAR PUBLISH TIME" Margin="0,5,0,0" Padding="5,2" Click="ClearPublishTime_Click" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </GroupBox>
    </Grid>

    <GroupBox Grid.Row="3" Header="PROCESS LOG" Background="#101319" Foreground="#D7E2F0" Margin="0,8,0,0">
      <RichTextBox x:Name="LogBox" Background="#101319" Foreground="#D7E2F0" BorderThickness="0" IsReadOnly="True" IsDocumentEnabled="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextOptions.TextFormattingMode="Display">
        <FlowDocument PagePadding="3" Background="#101319" TextAlignment="Left" />
      </RichTextBox>
    </GroupBox>

    <Border x:Name="EditorFooter" Grid.Row="4" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /><ColumnDefinition Width="145" /><ColumnDefinition Width="95" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="OUTPUT FOLDER" FontWeight="Bold" />
          <DockPanel Margin="0,3,8,0">
            <Button DockPanel.Dock="Right" Content="BROWSE" Width="75" Margin="6,0,0,0" Click="BrowseButton_Click" />
            <TextBox x:Name="OutputBox" IsReadOnly="True" />
          </DockPanel>
        </StackPanel>
        <Button x:Name="OpenFolderButton" Grid.Column="1" Content="OPEN FOLDER" Margin="8,17,0,0" Height="32" Click="OpenFolderButton_Click" />
        <Button x:Name="RenderButton" Grid.Column="2" Content="CREATE CLIP" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" Margin="8,17,0,0" Height="32" Click="RenderButton_Click" IsEnabled="False" />
        <Button x:Name="CancelButton" Grid.Column="3" Content="CANCEL" Margin="8,17,0,0" Height="32" Click="CancelButton_Click" IsEnabled="False" />
      </Grid>
    </Border>

    <Border x:Name="UploadFooter" Grid.Row="4" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9" Margin="0,8,0,0" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="UploadQueueSummaryText" Text="0 videos selected · 0 scheduled" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="AutoScheduleButton" Grid.Column="1" Content="AUTO-SCHEDULE" Margin="8,0,0,0" Height="32" Click="AutoScheduleButton_Click" />
        <Button x:Name="UploadDisabledButton" Grid.Column="2" Content="UPLOAD SCHEDULED VIDEOS" Margin="8,0,0,0" Height="32" Click="UploadSelectedVideos_Click" IsEnabled="False" ToolTip="Connect a YouTube channel and schedule the selected videos first." />
      </Grid>
    </Border>

    <Border Grid.Row="5" Background="#202020" Padding="6,4" Margin="0,4,0,0">
      <StackPanel>
        <TextBlock x:Name="StatusText" Foreground="#FFFFFF" Text="STATUS: Enter a YouTube URL, copy the Gemini prompt, or import a manifest." />
        <ProgressBar x:Name="WorkProgress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
