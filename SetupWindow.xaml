<Window x:Class="Clipper98.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipper 98 — Setup" Width="560" Height="500" MinWidth="500" MinHeight="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource FaceBrush}" FontFamily="Tahoma" FontSize="12">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource TitleBrush}" Padding="8,5" Margin="0,0,0,8">
      <TextBlock Text="SETUP CHECKER" Foreground="White" FontWeight="Bold" />
    </Border>
    <GroupBox Grid.Row="1" Header="KOMPONEN" Background="{StaticResource WindowBrush}">
      <TextBox x:Name="ChecksBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" />
    </GroupBox>
    <GroupBox Grid.Row="2" Header="PENYIMPANAN SEMENTARA" Background="{StaticResource WindowBrush}" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock x:Name="StorageSummaryText" Text="Menghitung temp/cache..." FontWeight="Bold" />
        <TextBlock Text="Yang dibersihkan hanya folder kerja/cache Clipper. Video hasil, model Whisper, API key, dan pengaturan tetap tersimpan." TextWrapping="Wrap" Foreground="#404040" Margin="0,5,0,0" />
      </StackPanel>
    </GroupBox>
    <DockPanel Grid.Row="3" Margin="0,9,0,0" LastChildFill="True">
      <Button x:Name="ClearTempButton" DockPanel.Dock="Left" Content="HAPUS TEMP/CACHE" Padding="10,4" Click="ClearTempButton_Click" />
      <Button DockPanel.Dock="Right" Content="TUTUP" Width="82" Padding="10,4" Click="CloseButton_Click" />
      <TextBlock x:Name="CleanupStatusText" Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#303030" />
    </DockPanel>
  </Grid>
</Window>
