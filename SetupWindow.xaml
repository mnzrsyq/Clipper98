<Window x:Class="Clipper98.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipper 98 - Setup" Width="620" Height="620" MinWidth="540" MinHeight="560" Language="en-US"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Closing="SetupWindow_Closing"
        Background="{DynamicResource FaceBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Tahoma" FontSize="12">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource TitleBrush}" Padding="8,5" Margin="0,0,0,8">
      <TextBlock Text="SYSTEM SETUP" Foreground="White" FontWeight="Bold" />
    </Border>
    <GroupBox Grid.Row="1" Header="APPEARANCE" Background="{DynamicResource WindowBrush}" Margin="0,0,0,8">
      <CheckBox x:Name="NightModeCheckBox" Content="Night mode" ToolTip="Use a darker version of the classic Clipper 98 interface." Checked="NightMode_Changed" Unchecked="NightMode_Changed" />
    </GroupBox>
    <GroupBox Grid.Row="2" Header="COMPONENTS" Background="{DynamicResource WindowBrush}">
      <TextBox x:Name="ChecksBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" />
    </GroupBox>
    <GroupBox Grid.Row="3" Header="TEMPORARY STORAGE" Background="{DynamicResource WindowBrush}" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock x:Name="StorageSummaryText" Text="Calculating temporary storage..." FontWeight="Bold" />
        <TextBlock Text="Cleanup removes Clipper working files and cache only. Rendered videos and downloaded components stay in place." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
      </StackPanel>
    </GroupBox>
    <StackPanel Grid.Row="4" Margin="0,8,0,0">
      <TextBlock x:Name="DownloadStatusText" Text="Missing components can be downloaded to the tools folder." TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
      <ProgressBar x:Name="DownloadProgressBar" Height="12" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,5,0,0" />
    </StackPanel>
    <DockPanel Grid.Row="5" Margin="0,9,0,0" LastChildFill="True">
      <Button x:Name="DownloadMissingButton" DockPanel.Dock="Left" Content="DOWNLOAD MISSING COMPONENTS" Padding="10,4" Margin="0,0,6,0" Click="DownloadMissingButton_Click" />
      <Button x:Name="ClearTempButton" DockPanel.Dock="Left" Content="CLEAR TEMP FILES" Padding="10,4" Click="ClearTempButton_Click" />
      <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="CANCEL DOWNLOAD" Width="112" Padding="10,4" Visibility="Collapsed" Click="CancelDownloadButton_Click" />
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="CLOSE" Width="82" Padding="10,4" Click="CloseButton_Click" />
      <TextBlock x:Name="CleanupStatusText" Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
    </DockPanel>
  </Grid>
</Window>
