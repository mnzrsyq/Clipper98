<Window x:Class="Clipper98.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipper 98 — Setup" Width="620" Height="570" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Closing="SetupWindow_Closing"
        Background="{StaticResource FaceBrush}" FontFamily="Tahoma" FontSize="12">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource TitleBrush}" Padding="8,5" Margin="0,0,0,8">
      <TextBlock Text="SETUP CHECKER" Foreground="White" FontWeight="Bold" />
    </Border>
    <GroupBox Grid.Row="1" Header="KOMPONEN" Background="{StaticResource WindowBrush}">
      <TextBox x:Name="ChecksBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="180" />
    </GroupBox>
    <GroupBox Grid.Row="2" Header="PENYIMPANAN SEMENTARA" Background="{StaticResource WindowBrush}" Margin="0,8,0,0">
      <StackPanel>
        <TextBlock x:Name="StorageSummaryText" Text="Menghitung temp/cache..." FontWeight="Bold" />
        <TextBlock Text="Yang dibersihkan hanya folder kerja/cache Clipper. Video hasil dan komponen terunduh tetap tersimpan." TextWrapping="Wrap" Foreground="#404040" Margin="0,5,0,0" />
      </StackPanel>
    </GroupBox>
    <StackPanel Grid.Row="3" Margin="0,8,0,0">
      <TextBlock x:Name="DownloadStatusText" Text="Komponen yang belum ada bisa diunduh otomatis ke folder tools." TextWrapping="Wrap" Foreground="#303030" />
      <ProgressBar x:Name="DownloadProgressBar" Height="12" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,5,0,0" />
    </StackPanel>
    <DockPanel Grid.Row="4" Margin="0,9,0,0" LastChildFill="True">
      <Button x:Name="DownloadMissingButton" DockPanel.Dock="Left" Content="UNDUH KOMPONEN KURANG" Padding="10,4" Margin="0,0,6,0" Click="DownloadMissingButton_Click" />
      <Button x:Name="ClearTempButton" DockPanel.Dock="Left" Content="HAPUS TEMP/CACHE" Padding="10,4" Click="ClearTempButton_Click" />
      <Button x:Name="CancelDownloadButton" DockPanel.Dock="Right" Content="BATALKAN" Width="92" Padding="10,4" Visibility="Collapsed" Click="CancelDownloadButton_Click" />
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="TUTUP" Width="82" Padding="10,4" Click="CloseButton_Click" />
      <TextBlock x:Name="CleanupStatusText" Margin="10,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#303030" />
    </DockPanel>
  </Grid>
</Window>
